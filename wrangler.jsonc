{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malique-portfolio-site",
  "main": "./worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "assets": {
    "directory": "./site-dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "maliquespooner.com/*",
      "zone_name": "maliquespooner.com"
    }
  ]
}
